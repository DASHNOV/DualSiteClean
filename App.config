<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- Chaînes de connexion par défaut -->
        <add key="ConnectionString39C" value="Server=SERVER_39C;Database=Amadeus;Integrated Security=true;Connect Timeout=30;Encrypt=False;" />
        <add key="ConnectionString19M" value="Server=SERVER_19M;Database=Amadeus;Integrated Security=true;Connect Timeout=30;Encrypt=False;" />
        
        <!-- Paramètres de l'application -->
        <add key="CheminSauvegardes" value="" />
        <!-- Si vide, utilise Mes Documents\DoublonManager\Sauvegardes -->
        
        <add key="CheminLogs" value="" />
        <!-- Si vide, utilise Mes Documents\DoublonManager\Logs -->
        
        <!-- Options d'analyse -->
        <add key="SeuilCompletudeMinimum" value="50" />
        <!-- Score minimum pour considérer une fiche valide (0-100) -->
        
        <add key="PrioritePhoto" value="true" />
        <!-- Si true, la présence de photo est prioritaire sur la complétude -->
        
        <!-- Options de sécurité -->
        <add key="ConfirmerAvantSuppression" value="true" />
        <add key="CreerSauvegardeAvantSuppression" value="true" />
        
        <!-- Options d'interface -->
        <add key="AfficherSplashScreen" value="true" />
        <add key="DureeSplashScreen" value="2000" />
        <!-- Durée en millisecondes -->
        
        <!-- Options de logging -->
        <add key="NiveauLog" value="Info" />
        <!-- Valeurs possibles: Debug, Info, Warning, Error -->
        
        <add key="LoggerDansConsole" value="true" />
        <add key="LoggerDansFichier" value="true" />
    </appSettings>
    
    <connectionStrings>
        <!-- Alternative aux appSettings pour les connection strings -->
        <add name="Amadeus39C" 
             connectionString="Server=SERVER_39C;Database=Amadeus;Integrated Security=true;Connect Timeout=30;Encrypt=False;" 
             providerName="System.Data.SqlClient" />
             
        <add name="Amadeus19M" 
             connectionString="Server=SERVER_19M;Database=Amadeus;Integrated Security=true;Connect Timeout=30;Encrypt=False;" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
